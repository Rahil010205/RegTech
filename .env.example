# Application
REGTECH_APP_NAME=RegTech Compliance API
REGTECH_DEBUG=false
REGTECH_API_V1_PREFIX=/api/v1
REGTECH_SECRET_KEY=change-me-in-production

# Database
REGTECH_DATABASE_URL=postgresql+psycopg2://regtech:regtech@localhost:5432/regtech
REGTECH_DB_POOL_SIZE=10
REGTECH_DB_MAX_OVERFLOW=20

# Qdrant (future hybrid retrieval — optional for ingestion pipeline)
REGTECH_QDRANT_URL=http://localhost:6333
REGTECH_QDRANT_API_KEY=
REGTECH_QDRANT_TIMEOUT=30

# Embeddings
REGTECH_EMBEDDING_PROVIDER=local
REGTECH_EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
REGTECH_EMBEDDING_DEVICE=cpu
REGTECH_EMBEDDING_BATCH_SIZE=32
REGTECH_EMBEDDING_DIMENSION=1024

# OpenAI embeddings (optional — set REGTECH_EMBEDDING_PROVIDER=openai)
REGTECH_OPENAI_API_KEY=
REGTECH_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Celery
REGTECH_CELERY_BROKER_URL=redis://localhost:6379/0
REGTECH_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
REGTECH_DATA_DIR=./data
REGTECH_MAX_UPLOAD_BYTES=26214400

# Retrieval
REGTECH_RETRIEVAL_TOP_K=10
REGTECH_RERANK_TOP_K=5
REGTECH_SIMILARITY_THRESHOLD=0.65
REGTECH_MATCHING_SIMILARITY_THRESHOLD=0.60

# Compliance
REGTECH_MANDATORY_CLAUSE_THRESHOLD=0.75

# Logging
REGTECH_LOG_LEVEL=INFO
REGTECH_LOG_JSON=false

# Security
REGTECH_JWT_ALGORITHM=HS256
REGTECH_ACCESS_TOKEN_EXPIRE_MINUTES=30
REGTECH_OTP_TTL_SECONDS=600

# Email OTP (Gmail: smtp.gmail.com + an App Password, not your login password)
REGTECH_SMTP_HOST=
REGTECH_SMTP_PORT=587
REGTECH_SMTP_USERNAME=
REGTECH_SMTP_PASSWORD=
REGTECH_SMTP_FROM=
REGTECH_SMTP_USE_TLS=true
